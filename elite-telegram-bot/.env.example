# Core
ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data.db
RUN_MIGRATIONS_ON_START=true

# Public URL / Railway
PUBLIC_BASE_URL=https://your-service.up.railway.app
RAILWAY_STATIC_URL=
RAILWAY_PUBLIC_DOMAIN=
PORT=8080

# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET_TOKEN=
WEBHOOK_PATH=/webhook/telegram
SET_WEBHOOK_ON_START=true
FAIL_FAST_ON_STARTUP=false
ADMIN_USER_IDS=

# Stripe
STRIPE_ENABLED=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOTIFY_ADMIN_ON_SALE=true
# Stripe catalog metadata recommendation:
# sku, featured, telegram_category, delivery_type, access_role, channel_announcement, button_label, sort_order

# Optional legacy price mappings
PRICE_ID_FOUNDER_KEY=
PRICE_ID_VIP_MONTH=
PRICE_ID_VIP_YEAR=

# AI
AI_ENABLED=true
AI_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-4o-mini
AI_OPENAI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_TIMEOUT_SECONDS=30

# Optional infrastructure
REDIS_URL=
